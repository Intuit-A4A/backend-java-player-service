{
  "uid": "availability",
  "title": "Availability",
  "tags": [
    "player-service"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tomcat",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tomcat busy threads (workers serving a request)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "max configured" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } },
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tomcat_threads_busy_threads",
          "legendFormat": "busy"
        },
        {
          "refId": "B",
          "expr": "tomcat_threads_config_max_threads",
          "legendFormat": "max configured"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "GET /v1/players",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completed requests (count in interval)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/v1/players\",method=\"GET\",status=\"200\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "200"
        },
        {
          "refId": "B",
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/v1/players\",method=\"GET\",status=\"503\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "503"
        },
        {
          "refId": "C",
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/v1/players\",method=\"GET\",status=\"500\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "500"
        },
        {
          "refId": "D",
          "expr": "sum(increase(http_server_requests_seconds_count{uri=\"/v1/players\",method=\"GET\",status=\"502\"}[$__rate_interval])) + sum(increase(http_server_requests_seconds_count{uri=\"/v1/players\",method=\"GET\",status=\"504\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "other 5xx"
        }
      ]
    },
